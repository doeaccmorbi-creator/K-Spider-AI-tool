// ═══════════════════════════════════════════════════════════════════════════
// K SPIDER AI — Firestore Security Rules  v7.4
// Project  : kspideraimain
// Updated  : May 2026  (v7.4 — rto_agent_requests added)
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │  COLLECTION MAP                                                         │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ users            │ Admin: full CRUD                                     │
// │                  │ Owner: read own + write safe fields only             │
// │                  │ Public: no access                                    │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ payments         │ Admin: full CRUD                                     │
// │                  │ LoggedIn user: read own, create new                  │
// │                  │ Public: no access                                    │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ tools            │ Admin: full CRUD                                     │
// │                  │ Public: read-only                                    │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ admin            │ Admin: full CRUD                                     │
// │  ├ site_settings │ Public: read-only                                    │
// │  ├ pricing       │ Public: read-only                                    │
// │  ├ tool_settings │ Public: read-only                                    │
// │  ├ tool_pricing  │ Public: read-only                                    │
// │  └ claude_usage  │ Admin only (internal API usage log)                  │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ ads              │ Admin: full CRUD                                     │
// │                  │ Public: read-only                                    │
// │                  │ Anyone: increment clicks + impressions only          │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ adRequests       │ Admin: full CRUD                                     │
// │                  │ Anyone: create (advertiser form)                     │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ instituteRequests│ Admin: full CRUD                                     │
// │                  │ Anyone: READ ← v7.1 FIX                             │
// │                  │ Anyone: create (Learn Smart Tool, no auth)           │
// │                  │ Anyone: update status/ban/expire fields only         │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ students         │ Admin: full CRUD                                     │
// │                  │ Anyone: create + update (Learn Smart Tool, no auth)  │
// │ └ /exams/{id}    │ Admin: full CRUD                                     │
// │                  │ Anyone: create + read (tool syncs without auth)      │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ franchise_inq..  │ Admin: full CRUD                                     │
// │                  │ Anyone: create (franchise form)                      │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ announcements    │ Admin: full CRUD                                     │
// │                  │ Public: read-only                                    │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ otp_store        │ Admin: full CRUD                                     │
// │                  │ Anyone: create (send OTP)                            │
// │                  │ LoggedIn: update own (verify OTP)                    │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ admin_notif..    │ Admin: full CRUD                                     │
// │                  │ LoggedIn: create (email queue)                       │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ user_api_keys    │ Admin: full CRUD (view/delete)   ← NEW in v7.2       │
// │ /{safeEmailId}   │ Owner: read + write own doc only                     │
// │                  │ Public: no access                                    │
// │                  │ Doc ID = email with . → _ and @ → _at_              │
// ├──────────────────┬──────────────────────────────────────────────────────┤
// │ wa_referrals     │ Admin: full CRUD                ← NEW in v7.3        │
// │ /{shortCode}     │ Anyone: read (banner display — ?ref=CODE)            │
// │                  │ Anyone: create (promo link registration form)        │
// │                  │ Admin: update status (approve/suspend/pending)       │
// │                  │ Anyone: update safe fields only (updatedAt)          │
// └──────────────────┴──────────────────────────────────────────────────────┘
//
// ─────────────────────────────────────────────────────────────────────────
// WHAT CHANGED: v7.2 → v7.3
// ─────────────────────────────────────────────────────────────────────────
//
// 1. wa_referrals collection — NEW
//    WHY: WA Broadcast Pro & WA Bulk Sender tools allow users to create
//    promotional referral links. When someone opens a tool via ?ref=CODE,
//    the tool reads the doc to show the agent's banner (name, logo, contact).
//    Doc ID = 6-char shortCode (e.g. "X7K2MQ")
//    SECURITY:
//    • Anyone can read (needed for banner display — unauthenticated tools)
//    • Anyone can create (form submission, no auth in tool)
//    • Only admin can change status (approve/suspend)
//    • Public update restricted to updatedAt field only
//    • Admin has full CRUD
//
// 2. ALL OTHER RULES — identical to v7.2, not touched.
//
// ═══════════════════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'kspider221206@gmail.com';
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(docId) {
      return isLoggedIn() && (
        request.auth.uid == docId
        ||
        request.auth.token.email
          .replace('.', '_').replace('.', '_').replace('.', '_')
          .replace('.', '_').replace('.', '_')
          .replace('#', '_').replace('$', '_')
          .replace('[', '_').replace(']', '_') == docId
      );
    }

    function userSafeFields() {
      return [
        'name', 'mobile', 'email',
        'country', 'state', 'city', 'cityPin',
        'language',
        'photoURL', 'loginMethod', 'loginCount',
        'lastLogin', 'lastSeen', 'updatedAt',
        'toolsUsed',
        'verified', 'createdAt'
      ];
    }

    // ─────────────────────────────────────────────────────────────────────
    // /users/{userId}
    // ─────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || (isLoggedIn() && isOwner(userId));
      allow update: if isAdmin()
                    || (
                          isOwner(userId)
                       && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(userSafeFields())
                       );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /payments/{paymentId}
    // ─────────────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:   if isAdmin()
                    || (
                          isLoggedIn()
                       && resource.data.userEmail == request.auth.token.email
                       );
      allow create: if isLoggedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /tools/{toolId}
    // ─────────────────────────────────────────────────────────────────────
    match /tools/{toolId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /admin/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /admin/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /ads/{adId}
    // ─────────────────────────────────────────────────────────────────────
    match /ads/{adId} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['clicks', 'impressions']);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /adRequests/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /adRequests/{docId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /instituteRequests/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /instituteRequests/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'status',         'updatedAt',
                           'approvedAt',     'rejectedAt',
                           'banStatus',      'banReason',
                           'bannedAt',       'unbannedAt',
                           'permissionDate', 'expireDate'
                         ]);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /students/{studentId}
    // ─────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read:   if isAdmin() || true;
      allow create: if true;
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'name', 'phone', 'email', 'city', 'state',
                           'goal', 'lastSeen', 'updatedAt', 'source', 'toolUrl'
                         ]);
      allow delete: if isAdmin();

      match /exams/{examId} {
        allow read:   if isAdmin() || true;
        allow create: if true;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // /franchise_inquiries/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /franchise_inquiries/{docId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /announcements/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /otp_store/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /otp_store/{docId} {
      allow read:   if isAdmin();
      allow create: if true;
      allow update: if isLoggedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /admin_notifications/{docId}
    // ─────────────────────────────────────────────────────────────────────
    match /admin_notifications/{docId} {
      allow read:   if isAdmin();
      allow create: if isLoggedIn() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /user_api_keys/{safeEmailId}                          ← NEW v7.2
    // ─────────────────────────────────────────────────────────────────────
    match /user_api_keys/{safeEmailId} {
      allow read:   if isAdmin() || isOwner(safeEmailId);
      allow create: if isAdmin()
                    || (isLoggedIn() && isOwner(safeEmailId));
      allow update: if isAdmin()
                    || (
                          isLoggedIn()
                       && isOwner(safeEmailId)
                       && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly([
                              'claude', 'groq', 'gemini',
                              'gai', 'openai',
                              'addedAt', 'updatedAt'
                            ])
                       );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /wa_referrals/{shortCode}                             ← NEW v7.3
    //
    // WA Broadcast Pro & WA Bulk Sender promo link system.
    // Users register → pending → admin approves → banner shows.
    // Doc ID = 6-char shortCode e.g. "X7K2MQ"
    //
    // SECURITY:
    //   • Anyone can READ (tools load banner via ?ref=CODE, no auth)
    //   • Anyone can CREATE (form submission from tool, no auth)
    //   • Only ADMIN can update status field (approve/suspend/pending)
    //   • Public update restricted to updatedAt only (tool-side safe)
    //   • Admin has full CRUD
    // ─────────────────────────────────────────────────────────────────────
    match /wa_referrals/{shortCode} {
      allow read:   if true;
      allow create: if true;
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['updatedAt']);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // /rto_agent_requests/{refId}                           ← NEW v7.4
    //
    // RTO Exam Pro Agent promotional link request system.
    // Agents submit registration from tool (no Firebase Auth).
    // Admin sees real-time notifications via onSnapshot listener.
    // Doc ID = agent refId (e.g. "RTO-ABC123")
    //
    // SECURITY:
    //   • Admin: full CRUD
    //   • Anyone: CREATE (agent submits without auth from RTO tool)
    //   • Anyone: READ own doc by refId (tool polls approval status)
    //   • Public update restricted to safe fields only
    //   • Sensitive status changes (approve/reject/suspend) = admin only
    // ─────────────────────────────────────────────────────────────────────
    match /rto_agent_requests/{refId} {
      allow read:   if true;            // Tool polls approval; doc ID not guessable
      allow create: if true;            // Agent submits form without Firebase Auth
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'updatedAt',    'source',
                           '_seen',        'logo'
                         ]);
      allow delete: if isAdmin();
    }

        // ─────────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // ─────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
